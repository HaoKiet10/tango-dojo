{
  "name": "tango-dojo",
  "version": "1.0.0",
  "description": "Luyện kanji và từ vựng tiếng Nhật N5–N3, giao diện tiếng Việt + tiếng Nhật. Vite + React + TypeScript + Tailwind, đăng lên GitHub Pages.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaoKiet10/tango-dojo.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/HaoKiet10/tango-dojo/issues"
  },
  "homepage": "https://github.com/HaoKiet10/tango-dojo#readme",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "private": true
}
